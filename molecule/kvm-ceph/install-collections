#!/usr/bin/env python3
"""Install scenario collections only inside the shared validated context."""

from contextlib import contextmanager
import fcntl
import os
from pathlib import Path
import stat
import subprocess
import sys

from scenario_context import context, owned_directory


def check_existing_tree(root: Path) -> None:
    """Never let Galaxy follow an existing link or overwrite a foreign inode."""
    pending = [root]
    count = 0
    while pending:
        directory = pending.pop()
        for child in directory.iterdir():
            count += 1
            if count > 20000:
                raise ValueError("Collections tree is unexpectedly large")
            info = child.lstat()
            if info.st_uid != os.getuid() or (
                not stat.S_ISDIR(info.st_mode) and
                (not stat.S_ISREG(info.st_mode) or info.st_nlink != 1)
            ):
                raise ValueError(f"Untrusted collections entry: {child}")
            if stat.S_IMODE(info.st_mode) & 0o022:
                raise ValueError(f"Writable collections entry: {child}")
            if stat.S_ISDIR(info.st_mode):
                pending.append(child)


@contextmanager
def collection_lock(ephemeral: Path):
    """Serialize private collection writes without following a lock-file link."""
    descriptor = os.open(
        ephemeral / ".ceph-collections.lock",
        os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK,
        0o600,
    )
    try:
        info = os.fstat(descriptor)
        if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid()
                or stat.S_IMODE(info.st_mode) != 0o600 or info.st_nlink != 1):
            raise ValueError("Untrusted collections lock")
        fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
        yield
    finally:
        os.close(descriptor)


def validated_destination(env: dict, role: Path) -> Path:
    """Resolve effective identity without allocating a generation or resources."""
    if Path.cwd().resolve() != role.resolve():
        raise ValueError("Install collections only from the role checkout")
    return Path(context("resolve", env, role)["collections_directory"])


def main() -> int:
    role = Path(__file__).resolve().parents[2]
    try:
        destination = validated_destination(dict(os.environ), role)
        with collection_lock(destination.parent):
            destination.mkdir(mode=0o700, exist_ok=True)
            owned_directory(destination)
            check_existing_tree(destination)
            inherited = os.environ.get("ANSIBLE_COLLECTIONS_PATH", "")
            galaxy_env = dict(
                os.environ,
                ANSIBLE_COLLECTIONS_PATH=str(destination) + (":" + inherited if inherited else ""),
            )
            subprocess.run(
                ["ansible-galaxy", "collection", "install", "-r",
                 "molecule/kvm-ceph/requirements.yml", "--collections-path",
                 str(destination), "--force"],
                check=True,
                env=galaxy_env,
            )
    except (ValueError, OSError, KeyError, TypeError,
            subprocess.CalledProcessError) as error:
        print(f"Refusing unsafe or failed context Galaxy install: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
